#!/usr/bin/env bash
set -uo pipefail

OK='[OK]'
WARN='[WARN]'
FAIL='[FAIL]'
INFO='[INFO]'
critical=0

ok()   { printf '%-7s %s\n' "$OK" "$*"; }
warn() { printf '%-7s %s\n' "$WARN" "$*"; }
fail() { printf '%-7s %s\n' "$FAIL" "$*"; critical=$((critical+1)); }
info() { printf '%-7s %s\n' "$INFO" "$*"; }
section() { printf '\n== %s ==\n' "$*"; }

unit_state() {
  local state
  state="$(systemctl is-enabled "$1" 2>/dev/null || true)"
  if [[ -n "$state" ]]; then
    printf '%s\n' "$state"
  else
    printf 'not-found\n'
  fi
}

printf 'Kobold Divination — read-only system security and health\n'
printf 'Time: %s\n' "$(date --iso-8601=seconds 2>/dev/null || date)"

section 'Deployment'
if ! command -v bootc >/dev/null 2>&1; then
  info 'bootc command not available in this environment'
elif bootc_status="$(bootc status 2>&1)"; then
  ok 'bootc deployment status available'
  sed 's/^/         /' <<<"$bootc_status" | head -20
elif grep -Eqi 'root privilege|root user|must (be|run|execute).*root' <<<"$bootc_status"; then
  info 'bootc status requires root; run: sudo bootc status'
else
  warn 'bootc status unavailable in this environment'
fi

if grep -q '^NAME="Kobold"$' /usr/lib/os-release 2>/dev/null; then
  ok 'human-facing OS identity: Kobold'
else
  warn 'Kobold NAME is not active in /usr/lib/os-release'
fi

section 'Mandatory access control'
if command -v getenforce >/dev/null 2>&1; then
  selinux="$(getenforce 2>/dev/null || true)"
  if [[ "$selinux" == Enforcing ]]; then
    ok 'SELinux Enforcing'
  else
    fail "SELinux state: ${selinux:-unknown}"
  fi
else
  fail 'getenforce missing'
fi

if command -v mokutil >/dev/null 2>&1; then
  sb="$(mokutil --sb-state 2>/dev/null || true)"
  [[ "$sb" == *enabled* ]] && ok "$sb" || warn "Secure Boot: ${sb:-undetectable}"
else
  info 'mokutil not available; Secure Boot not checked'
fi

section 'Host firewall and exposure'
if systemctl is-active --quiet firewalld 2>/dev/null; then
  zone="$(firewall-cmd --get-default-zone 2>/dev/null || printf unknown)"
  [[ "$zone" == drop ]] && ok 'firewalld active; default zone drop' || warn "firewalld active; default zone ${zone}"
else
  fail 'firewalld inactive'
fi

if command -v ss >/dev/null 2>&1; then
  listeners="$(ss -H -lntu 2>/dev/null | awk '$5 !~ /^127\./ && $5 !~ /^\[::1\]/ {print}' || true)"
  if [[ -z "$listeners" ]]; then
    ok 'no non-loopback TCP/UDP listeners detected'
  else
    warn 'non-loopback listeners exist; verify they are intentional:'
    sed 's/^/         /' <<<"$listeners" | head -20
  fi
fi

failed_units="$(systemctl --failed --no-legend 2>/dev/null | sed '/^[[:space:]]*$/d' || true)"
if [[ -z "$failed_units" ]]; then
  ok 'no failed systemd units'
else
  warn 'failed systemd units:'
  sed 's/^/         /' <<<"$failed_units" | head -20
fi

section 'Runtime policy'
rootful_state="$(unit_state podman.socket)"
if [[ "$rootful_state" == masked ]]; then
  ok 'rootful podman.socket masked'
else
  fail "rootful podman.socket state: ${rootful_state}"
fi

for unit in tailscaled.service input-remapper.service cups.socket cups.service containerd.service; do
  state="$(unit_state "$unit")"
  case "$state" in
    disabled|masked|static|not-found) ok "$unit: $state" ;;
    *) warn "$unit: $state" ;;
  esac
done

for unit in brew-update.timer brew-upgrade.timer rpm-ostree-countme.timer; do
  state="$(unit_state "$unit")"
  [[ "$state" == masked || "$state" == not-found ]] && ok "$unit: $state" || warn "$unit: $state"
done

uupd_state="$(unit_state uupd.timer)"
[[ "$uupd_state" == enabled || "$uupd_state" == static ]] && ok "uupd.timer: $uupd_state" || warn "uupd.timer: $uupd_state"

for forbidden in samba samba-winbind avahi ModemManager openssh-server podman-docker podman-compose toolbox trivy; do
  if rpm -q "$forbidden" >/dev/null 2>&1; then
    warn "forbidden/removed-policy package present: $forbidden"
  fi
done

section 'Bluetooth'
if command -v rfkill >/dev/null 2>&1; then
  bt="$(rfkill list bluetooth 2>/dev/null || true)"
  if [[ -n "$bt" ]]; then
    sed 's/^/         /' <<<"$bt" | head -12
  else
    info 'no Bluetooth rfkill device detected'
  fi
fi

section 'Virtualization'
[[ -e /dev/kvm ]] && ok '/dev/kvm available' || warn '/dev/kvm unavailable in this boot/environment'

qemu_conf=/etc/libvirt/qemu.conf
if [[ -r "$qemu_conf" ]]; then
  if grep -q '^security_require_confined[[:space:]]*=[[:space:]]*1' "$qemu_conf" && \
     grep -q '^security_default_confined[[:space:]]*=[[:space:]]*1' "$qemu_conf"; then
    ok 'Quarantine libvirt requires confined system-QEMU guests'
  else
    fail 'Quarantine libvirt confinement requirement missing'
  fi
elif [[ -e "$qemu_conf" || ! -x "$(dirname "$qemu_conf")" ]]; then
  info 'Quarantine libvirt confinement not verifiable without privilege'
else
  fail 'Quarantine libvirt qemu.conf missing'
fi

if command -v virsh >/dev/null 2>&1 && virsh -c qemu:///system uri >/dev/null 2>&1; then
  ok 'qemu:///system reachable'
  mapfile -t vms < <(virsh -c qemu:///system list --all --name 2>/dev/null | sed '/^$/d')
  if ((${#vms[@]} == 0)); then
    info 'no Quarantine VMs defined'
  else
    for vm in "${vms[@]}"; do
      state="$(virsh -c qemu:///system domstate "$vm" 2>/dev/null || printf unknown)"
      label="$(virsh -c qemu:///system dominfo "$vm" 2>/dev/null | awk -F: '/Security label/ {sub(/^[[:space:]]+/,"",$2); print $2; exit}')"
      if [[ "$state" == running ]]; then
        [[ "$label" == *svirt_t* ]] && ok "$vm: running with sVirt label $label" || fail "$vm: running without visible sVirt_t label (${label:-none})"
      else
        info "$vm: $state${label:+; label $label}"
      fi

      xml="$(virsh -c qemu:///system dumpxml "$vm" --inactive 2>/dev/null || true)"
      risky=()
      grep -q '<filesystem ' <<<"$xml" && risky+=(filesystem-share)
      grep -q '<hostdev ' <<<"$xml" && risky+=(host-device-passthrough)
      grep -q '<redirdev ' <<<"$xml" && risky+=(usb-redirection)
      grep -q "channel type=['\"]spicevmc" <<<"$xml" && risky+=(spice-clipboard-channel)
      if ((${#risky[@]})); then
        warn "$vm: Quarantine integration to review: ${risky[*]}"
      fi
    done
  fi
else
  warn 'qemu:///system not reachable for this user/session (Polkit authorization may be required)'
fi

section 'Recent SELinux denials'
if command -v ausearch >/dev/null 2>&1; then
  avc="$(ausearch -m AVC,USER_AVC -ts boot 2>/dev/null | grep -v '^----$' | tail -20 || true)"
  if [[ -n "$avc" ]]; then
    warn 'recent AVC records visible to this user:'
    sed 's/^/         /' <<<"$avc"
  else
    ok 'no readable AVC denials since boot'
  fi
else
  info 'ausearch unavailable; AVC summary skipped'
fi

section 'Resource health'
if command -v free >/dev/null 2>&1; then
  free -h | sed 's/^/         /'
fi
for p in cpu memory io; do
  [[ -r "/proc/pressure/$p" ]] && printf '         PSI %-6s %s\n' "$p" "$(head -1 "/proc/pressure/$p")"
done
if command -v sensors >/dev/null 2>&1; then
  printf '         Thermal summary:\n'
  sensors 2>/dev/null | grep -E '^(Package id|Tctl|Tdie|temp[0-9]+:|edge:|Composite:)' | head -12 | sed 's/^/         /' || true
fi

printf '\n'
if ((critical)); then
  printf '%s %d critical finding(s).\n' "$FAIL" "$critical"
  exit 1
fi
printf '%s no critical finding detected. Review WARN entries in context.\n' "$OK"
